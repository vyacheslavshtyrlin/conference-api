# API service environment
# Copy to .env for local service-only development.

# Local service-only development: development.
# Production: use production, as shown in deploy/env/two-server.env.example.
NODE_ENV=development
PORT=3000

# Docker image used by docker-compose.yml in deploy mode.
# Production: change registry/project/tag if the image name differs.
API_IMAGE=registry.git.victory-crm.ru/conference/api:latest

# Redis used for room metadata, participants and TTL state.
# Local service-only development: localhost.
# Production: private media server IP/DNS, for example redis://10.0.0.12:6379.
REDIS_URL=redis://localhost:6379

# Public URL used to build room join links.
# Production: public web origin, for example https://conference.example.com.
WEB_PUBLIC_URL=http://localhost:5173

# Media node assigned to newly created rooms.
# Production MVP: usually media-1.
MEDIA_NODE_ID=local
# Production: public WebSocket URL through edge nginx, for example wss://conference.example.com/ws.
SIGNALING_PUBLIC_URL=ws://localhost:4000/ws

# Must match the media/signaling service.
# Production: change to a strong shared secret and use the same value in media/.env.
JOIN_TOKEN_SECRET=change-me-for-local-development

# Optional. Defaults to JOIN_TOKEN_SECRET when omitted.
# CREATOR_TOKEN_SECRET=change-me-for-local-development

# Join token lifetime in seconds.
# Usually keep unless product/security policy changes.
JOIN_TOKEN_TTL_SECONDS=300
