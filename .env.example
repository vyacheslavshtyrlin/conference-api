# API service environment example. Replace every placeholder before deploying.

NODE_ENV=production
PORT=3000

REDIS_URL=redis://redis:6379
WEB_PUBLIC_URL=https://conference.example.com

MEDIA_NODE_ID=media-prod-1
SIGNALING_PUBLIC_URL=wss://media.example.com/ws

# Optional trusted parent-domain cookie support.
AUTH_COOKIE_ENABLED=false
INTEGRATION_API_ENABLED=false
# Optional URL for auth-capable browser flows. Omit when unused.
# AUTH_LOGIN_URL=https://users.example.com/login

# Trusted parent-domain cookie JWT settings.
# Required when AUTH_COOKIE_ENABLED=true.
AUTH_COOKIE_NAME=conference_identity
AUTH_COOKIE_JWT_ISSUER=https://users.example.com
AUTH_COOKIE_JWT_AUDIENCE=conference
AUTH_COOKIE_JWT_HS256_SECRET=replace-with-cookie-jwt-secret

# Integration service JWT registry. Required when INTEGRATION_API_ENABLED=true.
# Each trusted backend has one independent credential. JWT `sub` is required and must exactly equal its integrationId.
# Keep each HS256 secret private to that backend and rotate it independently.
# recordingCallback is allowlisted deployment configuration for the worker. It is never accepted in a room-create payload.
# Its secret is distinct from hs256Secret and is used only for worker-to-integration callbacks.
INTEGRATION_JWT_CREDENTIALS_JSON='[{"integrationId":"crm-alpha","issuer":"crm-alpha","audience":"conference-integrations","hs256Secret":"replace-with-a-distinct-32-character-minimum-secret","recordingCallback":{"baseUrl":"https://crm-alpha.example/internal/conference-recording","audience":"crm-alpha-recording-worker","hs256Secret":"replace-with-another-distinct-32-character-minimum-secret"}}]'
INTEGRATION_JWT_MAX_TTL_SECONDS=900
INTEGRATION_RATE_LIMIT_WINDOW_SECONDS=60
INTEGRATION_RATE_LIMIT_MAX_REQUESTS=60

# Private signaling-to-API recording-control JWT validation. Configure all three fields when the recording bridge is enabled.
# RECORDING_CONTROL_JWT_ISSUER=conference-signaling
# RECORDING_CONTROL_JWT_AUDIENCE=conference-recording-control
# RECORDING_CONTROL_JWT_HS256_SECRET=replace-with-recording-control-secret
# RECORDING_CONTROL_JWT_MAX_TTL_SECONDS=300

# Shared media/signaling token settings.
# JOIN_TOKEN_SECRET must match the media service value.
JOIN_TOKEN_SECRET=replace-with-shared-join-token-secret
JOIN_TOKEN_TTL_SECONDS=300
ROOM_SESSION_TOKEN_SECRET=replace-with-room-session-token-secret
