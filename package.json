{
  "name": "@conference/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#contracts": {
      "production": "./dist/src/contracts/index.js",
      "types": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node --conditions=production dist/src/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "redis": "6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/testing": "10.4.15",
    "@types/node": "^22.10.2",
    "@types/supertest": "6.0.2",
    "eslint": "^9.17.0",
    "supertest": "7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
